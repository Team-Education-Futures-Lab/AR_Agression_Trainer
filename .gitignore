# =============== #
# Unity .gitignore
# =============== #

# OS-specific files
.DS_Store
Thumbs.db

# Unity-generated folders
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Mm]emoryCaptures/
[Bb]ehaviourTree/

# Unity cache
UserSettings/
*.pidb
*.suo
*.user
*.userprefs
*.unityproj
*.booproj

# Rider / VSCode / Visual Studio
.vscode/
.idea/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb

# Build artifacts
*.apk
*.aab
*.xcodeproj/
*.xcworkspace/
*.xcuserdata/
*.gradle/
*.jar
*.keystore

# Crash reports
sysinfo.txt

# Auto-generated Unity files
*.stackdump
*.log

# Addressables
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin
/[Aa]ssets/[Ss]treamingAssets/aa/

# Asset Store tools
[Aa]ssets/AssetStoreTools*

# Ignore build results
*.unitypackage

# Optional: If you use Collaborate/Plastic SCM
/[Pp]lastic/
/.collabignore

# JetBrains Rider
.idea/
*.sln.iml

# VS Code
.vscode/

# Local build cache
[Bb]uilds/
/[Bb]uild/

# Lightmaps
[Aa]ssets/**/Lightmap-*
[Aa]ssets/**/LightingData.asset
[Aa]ssets/**/ReflectionProbe-*

# Auto-generated Addressables
[Aa]ssets/**/AddressableAssetsData/*

# =========== #
# End of file #
# =========== #